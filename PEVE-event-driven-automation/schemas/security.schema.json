{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://peve.local/schemas/security.schema.json",
  "title": "RBAC YAML security/ (PEVE-kafka-connect-resources-v1)",
  "type": "object",
  "required": ["cluster"],
  "additionalProperties": true,
  "properties": {
    "cluster": {
      "type": "object",
      "required": ["cc"],
      "properties": {
        "cc": {
          "type": "object",
          "required": ["rbac"],
          "additionalProperties": true,
          "properties": {
            "rbac": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["principal", "resources"],
                "properties": {
                  "principal": { "type": "string", "minLength": 1 },
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["resource_type", "resource_name", "pattern_type", "role"],
                      "properties": {
                        "resource_type": {
                          "type": "string",
                          "enum": ["topic", "subject", "group", "transactional-id"]
                        },
                        "resource_name": { "type": "string", "minLength": 1 },
                        "pattern_type": {
                          "type": "string",
                          "enum": ["LITERAL", "PREFIXED"]
                        },
                        "role": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": ["operation"],
                            "properties": {
                              "operation": {
                                "type": "string",
                                "enum": [
                                  "DeveloperRead",
                                  "DeveloperWrite",
                                  "DeveloperManage",
                                  "ResourceOwner"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
