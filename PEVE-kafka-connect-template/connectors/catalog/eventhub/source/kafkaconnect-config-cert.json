{
  "name": "[CONNECTOR_NAME_UNICO]",
  "config": {
    "connector.class": "io.confluent.connect.azure.eventhubs.EventHubsSourceConnector",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "tasks.max": "1",
    "kafka.topic": "[TOPICO_DESTINO_EVENTOS]",
    "max.events": "1",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "https://psrc-j5nvyw.eastus2.azure.confluent.cloud",
    "value.converter.basic.auth.credentials.source": "USER_INFO",
    "value.converter.basic.auth.user.info":"${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/confluent-sr.username}:${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.schema.secret}",
    "value.converter.schemas.enable": false,
    "value.converter.auto.register.schemas":false,
    "value.converter.use.latest.version":true,
    "azure.eventhubs.sas.keyname": "[EVENTHUB_SAS_KEY_NAME]",
    "azure.eventhubs.sas.key": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/ehub.password}",
    "azure.eventhubs.namespace": "[EVENTHUB_NAMESPACE]",
    "azure.eventhubs.hub.name": "[EVENTHUB_NAME]",
    "confluent.topic.bootstrap.servers": "",
    "confluent.topic":"_confluent-command",
    "confluent.topic.sasl.mechanism": "PLAIN",
    "confluent.topic.security.protocol": "SASL_SSL",
    "confluent.topic.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.key}'   password='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.secret}';",
    "transforms" : "ToAvroAuditWithSchema",
    "transforms.ToAvroAuditWithSchema.type" : "com.bcp.peve.kafka.connect.smt.BytesToAvroAuditWithSchemaParser$Value",
    "errors.tolerance":"all",
    "errors.log.enable":"true",
    "errors.log.include.messages": "true"
  }
}

