{
  "name": "[CONNECTOR_NAME_UNICO]",
  "config": {
  "connector.class": "io.confluent.connect.azure.datalake.gen2.AzureDataLakeGen2SinkConnector",
  "key.converter" : "org.apache.kafka.connect.json.JsonConverter",   
  "value.converter":"org.apache.kafka.connect.json.JsonConverter",
  "tasks.max": "1",
  "topics": "[TOPICO_ORIGEN_EVENTOS]",    
  "flush.size": "5",
  "topics.dir": "topics2",

  "azure.datalake.gen2.account.name": "",
  "azure.datalake.gen2.client.id": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/adls.client.id}",
  "azure.datalake.gen2.client.key": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/adls.client.key}",    
  "azure.datalake.gen2.token.endpoint": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/adls.token.endpoint}",

  "format.class": "io.confluent.connect.azure.storage.format.json.JsonFormat",
  "confluent.topic.bootstrap.servers": "",
  "confluent.topic":"_confluent-command",
  "confluent.topic.sasl.mechanism": "PLAIN",
  "confluent.topic.security.protocol": "SASL_SSL",
  "confluent.topic.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.key}'   password='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.secret}';",



  "partitioner.class": "io.confluent.connect.storage.partitioner.HourlyPartitioner",
  "path.format": "'dt'=YYYY-MM-dd/'hour'=HH/",
  "locale":"en-US",
  "timezone": "UTC",

  "schema.compatibility":"NONE",

  "value.converter.schemas.enable": "false",
  "rotate.interval.ms": "5000",
  "timestamp.extractor":"Record",

  "errors.tolerance":"all",
  "errors.log.enable":"true",
  "errors.log.include.messages": "true",
  "errors.deadletterqueue.topic.name": "[TOPICO_DLQ]",
  "errors.deadletterqueue.context.headers.enable": "true"
  }
}
