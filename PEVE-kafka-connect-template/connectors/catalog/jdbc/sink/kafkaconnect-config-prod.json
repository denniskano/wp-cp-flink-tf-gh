{
  "name": [CONNECTOR_NAME_UNICO],
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "topics": [TOPICOS_ORIGEN_EVENTOS],
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "demo-loc-ttib-operations-dlq3",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "connection.url": "jdbc:sqlserver://msqleu2ttibd01.database.windows.net:1433;database=MSQLEU2TTIBDINT01;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;",
    "connection.user": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/connection.username}",
    "connection.password": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/connection.password}",
    "dialect.name": "SqlServerDatabaseDialect",
    "auto.create": "true",
    "table.name.format": "EVENT_LOG",
 
    "value.converter.schemas.enable": "true",
    "insert.mode": "upsert",
    "pk.mode": "kafka",
    "pk.fields": "__connect_topic,__connect_partition,__connect_offset",
    "auto.evolve": "true",
    "max.retries": "10",
    "retry.backoff.ms": "10000",
    "transforms": "TimestampConverter1,TimestampConverter2,TimestampConverter3",
    "transforms.TimestampConverter1.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter1.format": "yyyy-MM-dd hh:mm:ss.SSS",
    "transforms.TimestampConverter1.target.type": "Timestamp",
    "transforms.TimestampConverter1.field": "time_ace",
    "transforms.TimestampConverter2.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter2.format": "yyyy-MM-dd hh:mm:ss.SSS",
    "transforms.TimestampConverter2.target.type": "Timestamp",
    "transforms.TimestampConverter2.field": "datetime",
    "transforms.TimestampConverter3.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter3.format": "yyyy-MM-dd hh:mm:ss.SSS",
    "transforms.TimestampConverter3.target.type": "Timestamp",
    "transforms.TimestampConverter3.field": "datetime_cce"
  }
}
