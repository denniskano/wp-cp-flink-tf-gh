{
  "name": "[CONNECTOR_NAME_UNICO]",
  "config" : {
    "connector.class": "io.confluent.salesforce.SalesforcePlatformEventSinkConnector",
    "tasks.max" : "1",
    "topics": "[TOPICOS_ORIGEN_EVENTOS]",      
    "salesforce.username": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/salesforce.username}",
    "salesforce.password": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/salesforce.password}",
    "salesforce.consumer.key": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/salesforce.key}",
    "salesforce.consumer.secret": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/salesforce.secret}",
    "salesforce.password.token": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/salesforce.token}",
    "salesforce.instance": "https://test.salesforce.com/",
    "salesforce.platform.event.name" : "BCP_Asignar_Dato__e",
    "confluent.topic.bootstrap.servers": "",
    "confluent.topic":"_confluent-command",
    "confluent.topic.sasl.mechanism": "PLAIN",
    "confluent.topic.security.protocol": "SASL_SSL",
    "confluent.topic.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.key}'   password='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.secret}';",
    "connection.timeout": "50000",
    "request.max.retries.time.ms" : "120000",
    "behavior.on.api.errors" : "log",
    "reporter.result.topic.name": "",
    "reporter.error.topic.name": "" ,
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "[DLQ_TOPIC_CONNECTOR]",
    "errors.log.enable" : "true",
    "errors.log.include.messages": "true"  } 	
}

