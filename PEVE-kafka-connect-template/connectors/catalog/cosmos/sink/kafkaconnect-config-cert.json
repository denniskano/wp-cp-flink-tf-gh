{
  "name": "[CONNECTOR_NAME_UNICO]",
  "config": {
    "connector.class": "com.azure.cosmos.kafka.connect.sink.CosmosDBSinkConnector",
    "tasks.max": "1",
    "topics": "[TOPICO_ORIGEN_EVENTOS]",    
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "connect.cosmos.connection.endpoint": "",
    "connect.cosmos.master.key": "${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/cosmos.master.key}",
    "connect.cosmos.databasename": "KafkaConnectorDB",
    "connect.cosmos.containers.topicmap": "cloud-cdb-sink-prueba#KConnectItems",
    "confluent.topic.bootstrap.servers": "",
    "confluent.topic":"_confluent-command",
    "confluent.topic.sasl.mechanism": "PLAIN",
    "confluent.topic.security.protocol": "SASL_SSL",
    "confluent.topic.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.key}'   password='${securepass:/opt/security/secrets/security-secrets.properties:encrypted-config-file.properties/kafka.broker.secret}';"

  }
}
