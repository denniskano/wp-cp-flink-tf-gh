        <mxCell id="warn" value="No pares v1 en el mismo apply que crea v2. No uses SET ni scan.startup.mode (pisa el carry-over). Chequeo de PENDING = terraform plan (refresh), no la consola del pool. Si dejas v1 Stopped + managed, a los 30 días CCloud lo borra y Terraform lo recrea." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="dml">
          <mxGeometry x="24" y="168" width="1350" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="leg" value="paused / in-place: solo stopped true|false · cambiar el SQL = nuevo YAML y nuevo statement-name · properties.initial-offset-from = nombre de la versión Running · latest_offsets solo cuando está Stopped" style="text;html=1;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="dml">
          <mxGeometry x="24" y="236" width="1350" height="40" as="geometry"/>
