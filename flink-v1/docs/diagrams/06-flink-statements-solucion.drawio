        <mxCell id="jobs" value="Statements en el pool" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=11;fontStyle=1;startSize=26;" vertex="1" parent="cc">
          <mxGeometry x="20" y="264" width="1080" height="136" as="geometry"/>
        </mxCell>
        <mxCell id="job-alter" value="ALTER headers&lt;br&gt;apply: once → COMPLETED&lt;br&gt;&gt;30 días: apply ignore&lt;br&gt;si no, re-ADD y falla" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="jobs">
          <mxGeometry x="16" y="36" width="200" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="job-v1" value="DML v1  Running / Stopped&lt;br&gt;insert-filtered-passthrough&lt;br&gt;passthrough + WHERE&lt;br&gt;stopped in-place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="jobs">
          <mxGeometry x="232" y="36" width="220" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="job-v2" value="DML v2  PENDING → Running&lt;br&gt;initial-offset-from: v1&lt;br&gt;PENDING no sale en el pool&lt;br&gt;user_id = v2:…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="jobs">
          <mxGeometry x="468" y="36" width="220" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="job-metrics" value="Métricas ≠ offset&lt;br&gt;Messages Behind = lag&lt;br&gt;latest_offsets solo Stopped&lt;br&gt;Flink no es consumer group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="jobs">
          <mxGeometry x="704" y="36" width="220" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="job-note" value="SQL inmutable" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;fontColor=#666666;" vertex="1" parent="jobs">
          <mxGeometry x="932" y="56" width="130" height="48" as="geometry"/>
        </mxCell>

        <!-- arrows IAC → CC -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0066cc;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" parent="1" source="gha" target="pool">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a1l" value="apply" style="edgeLabel;html=1;align=center;fontSize=10;fontStyle=1;fontColor=#0066cc;" vertex="1" connectable="0" parent="a1">
          <mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- ========== CARRY-OVER ========== -->
        <mxCell id="co" value="Versionado DML — dos apply (nunca create de la nueva + stop de la anterior en el mismo)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff4e1;strokeColor=#d79b00;fontSize=13;fontStyle=1;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="40" y="536" width="1680" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="Apply 1 — crear vN+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="co">
          <mxGeometry x="24" y="52" width="400" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="s1b" value="vN  stopped: false  (sigue Running)&lt;br&gt;vN+1  YAML nuevo, otro statement-name&lt;br&gt;&lt;br&gt;properties:&lt;br&gt;  sql.tables.initial-offset-from: &quot;&lt;nombre vN&gt;&quot;&lt;br&gt;&lt;br&gt;Plan: solo + create de vN+1&lt;br&gt;Terraform: Creation complete (~16s)&lt;br&gt;Estado real: PENDING (hasta 6 h)&lt;br&gt;Consola del pool: no la lista" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;" vertex="1" parent="s1">
          <mxGeometry x="12" y="32" width="376" height="168" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="Apply 2 — stop vN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="co">
          <mxGeometry x="456" y="52" width="400" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="s2b" value="vN  stopped: true&lt;br&gt;vN+1  no se toca&lt;br&gt;&lt;br&gt;Plan: ~ update in-place (0 add, 0 destroy)&lt;br&gt;CCloud: savepoint de vN&lt;br&gt;vN+1: PENDING → Running&lt;br&gt;Offsets de vN (stateless only)&lt;br&gt;Consola: vN Stopped, vN+1 Running&lt;br&gt;Dest: p.ej. user_id = v2:…" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;" vertex="1" parent="s2">
          <mxGeometry x="12" y="32" width="376" height="168" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="Después del corte" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="co">
          <mxGeometry x="888" y="52" width="400" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="s3b" value="vN+1 se queda managed / stopped: false&lt;br&gt;vN → apply: ignore&lt;br&gt;&lt;br&gt;Plan: destroy del job viejo (no la tabla)&lt;br&gt;Si dejas vN Stopped + managed:&lt;br&gt;CCloud borra el statement a ~30 días&lt;br&gt;el próximo apply lo recrea (offsets 0)&lt;br&gt;riesgo: dos writers al mismo dest&lt;br&gt;ALTER &gt;30 días: ignore sí o sí" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;" vertex="1" parent="s3">
          <mxGeometry x="12" y="32" width="376" height="168" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="Reglas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="co">
          <mxGeometry x="1320" y="52" width="336" height="208" as="geometry"/>
        </mxCell>
        <mxCell id="s4b" value="Clave = statement-name, no el .yaml&lt;br&gt;No SET en el SQL&lt;br&gt;No scan.startup.mode (pisa carry-over)&lt;br&gt;Solo pipelines stateless&lt;br&gt;Chequeo PENDING = terraform plan&lt;br&gt;(refresh GET, no la lista del pool)&lt;br&gt;stopped: false / true  (boolean YAML)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;" vertex="1" parent="s4">
          <mxGeometry x="12" y="32" width="312" height="168" as="geometry"/>
        </mxCell>

        <mxCell id="arr-s1s2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=classic;" edge="1" parent="co" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr-s2s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=classic;" edge="1" parent="co" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="footer" value="Fuente: módulo ccloud-flink-statements · docs/FLINK_STATEMENTS.md · validado DES PEVE (v1 Stopped → v2 Running con carry-over)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#777777;" vertex="1" parent="1">
