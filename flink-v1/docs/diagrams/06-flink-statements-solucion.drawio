        <mxCell id="title" value="Ciclo de vida de statements Flink (flink-v1)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="640" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Topics + Avro ya existen. DDL = solo ALTER TABLE. DML = INSERT (SQL inmutable). Clave Terraform = statement-name." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="44" width="900" height="22" as="geometry"/>
        </mxCell>

        <!-- DDL -->
        <mxCell id="ddl" value="DDL  ·  ALTER TABLE  ·  ddl/*.yaml" style="swimlane;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1400" height="260" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="1. YAML nuevo&lt;br&gt;apply: once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ddl">
          <mxGeometry x="24" y="60" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="2. terraform apply&lt;br&gt;ALTER … ADD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ddl">
          <mxGeometry x="244" y="60" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="3. COMPLETED&lt;br&gt;columna queda en catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ddl">
          <mxGeometry x="464" y="60" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="4. ~30 días&lt;br&gt;CCloud borra el statement&lt;br&gt;(la columna no)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ddl">
          <mxGeometry x="704" y="52" width="200" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="5a. apply: ignore&lt;br&gt;OK · no re-ejecuta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="ddl">
          <mxGeometry x="964" y="36" width="180" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="d6" value="5b. managed / once&lt;br&gt;re-ADD → falla&lt;br&gt;bloquea el DML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="ddl">
          <mxGeometry x="964" y="116" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dnote" value="Si el marcador once sigue en el state, no re-crea. ignore sí o sí cuando el ALTER ya corrió hace más de un mes." style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="ddl">
          <mxGeometry x="24" y="200" width="900" height="36" as="geometry"/>
        </mxCell>

