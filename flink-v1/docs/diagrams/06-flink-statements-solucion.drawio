        <mxCell id="catalog" value="Catálogo Flink (auto-registro)&lt;br&gt;bcp_desa . AZURE_EU2_DESA_KAFKA01&lt;br&gt;las tablas = topics. ALTER solo agrega metadata (headers)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="cc">
          <mxGeometry x="560" y="56" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rest" value="REST Flink privado&lt;br&gt;Terraform GET/POST statements&lt;br&gt;La laptop no llega; el pipeline sí." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="cc">
