        <mxCell id="title" value="flink-v1 — Statements Flink en IAC (YAML + Terraform + CCloud)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="820" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Topics Kafka + Avro ya existen. Flink los lee (auto-registro). No hay CREATE TABLE. El SQL es inmutable: versionar = nuevo statement-name + carry-over de offsets." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1100" height="28" as="geometry"/>
        </mxCell>

        <!-- ========== IAC ========== -->
        <mxCell id="iac" value="IAC  ·  repo de la app (CODAPP)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e1f5ff;strokeColor=#0066cc;fontSize=13;fontStyle=1;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="40" y="88" width="520" height="420" as="geometry"/>
        </mxCell>

        <mxCell id="yaml-ddl" value="ddl/*.yaml&lt;br&gt;&lt;b&gt;solo ALTER TABLE&lt;/b&gt;&lt;br&gt;statement-name · pool · apply · statement&lt;br&gt;Ej. ADD headers METADATA VIRTUAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#0066cc;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="iac">
