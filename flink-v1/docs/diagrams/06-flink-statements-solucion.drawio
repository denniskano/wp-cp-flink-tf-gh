        <!-- DML -->
        <mxCell id="dml" value="DML  ·  INSERT INTO SELECT  ·  dml/*.yaml  ·  apply omitido = managed" style="swimlane;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;startSize=36;" vertex="1" parent="1">
          <mxGeometry x="40" y="368" width="1400" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="1. YAML v1&lt;br&gt;stopped: false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="dml">
          <mxGeometry x="24" y="56" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="2. apply&lt;br&gt;RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="dml">
          <mxGeometry x="214" y="56" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="3. YAML v2&lt;br&gt;otro statement-name&lt;br&gt;offset-from: v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="dml">
          <mxGeometry x="394" y="48" width="180" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="4. Apply 1&lt;br&gt;v2 PENDING&lt;br&gt;no se ve en el pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="dml">
          <mxGeometry x="614" y="48" width="170" height="86" as="geometry"/>
        </mxCell>
